# =========================================
# AI Jira QA Copilot v2 — Environment vars
# =========================================
# This file is the template. Real values must go in apps/web/.env.local
# (gitignored). On first ./run-dev.sh, this file is copied to that location.
# Never commit real keys to this file.
#
# In Vercel, set these in Project Settings → Environment Variables.

# --- Session encryption ---
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-32-byte-random-secret-min-length-32

# --- LLM providers (at least one is required) ---
# OpenAI:  https://platform.openai.com/api-keys
# Gemini:  https://aistudio.google.com/app/apikey
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: pin model names (defaults shown)
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash

# --- Default provider ---
# One of: openai | gemini
DEFAULT_LLM_PROVIDER=openai

# --- Python sidecar (optional) ---
# When deployed on Vercel both TS and Python run on the same domain.
# Frontend talks to Python via /pyapi/* (rewritten by vercel.json).
PYTHON_API_BASE=/pyapi
